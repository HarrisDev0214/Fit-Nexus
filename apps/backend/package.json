{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bin/www.ts",
    "start": "node dist/www.js",
    "build": "tsup",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "db:generate": "read -p 'Migration name: ' name && drizzle-kit generate --name=$name",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "argon2": "0.44.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.1",
    "express": "5.2.1",
    "express-basic-auth": "1.2.1",
    "express-rate-limit": "8.3.1",
    "jsonwebtoken": "9.0.3",
    "pg": "8.18.0",
    "pino": "10.3.1",
    "resend": "6.9.3",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/ms": "2.1.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.16.0",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "drizzle-kit": "0.31.9",
    "openapi3-ts": "4.5.0",
    "pino-pretty": "13.1.3",
    "tsup": "8.5.1",
    "tsx": "4.19.0",
    "typescript": "5.9.3"
  }
}
