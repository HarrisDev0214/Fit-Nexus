{
  "name": "fit-nexus",
  "version": "0.0.0",
  "description": "A fitness tracking application for recording workouts, tracking progress, and achieving health goals",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "turbo run lint",
    "lint:client": "turbo run lint -F client",
    "check-types": "turbo run check-types",
    "check-types:client": "turbo run check-types -F client",
    "build:client": "turbo run build -F client"
  },
  "keywords": [
    "fitness",
    "workout",
    "health",
    "tracking"
  ],
  "author": "Harris",
  "license": "ISC",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.9.0",
    "eslint": "10.0.2",
    "eslint-plugin-turbo": "2.8.10",
    "eslint-plugin-vue": "10.8.0",
    "globals": "17.3.0",
    "turbo": "2.8.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vue-eslint-parser": "10.4.0"
  }
}
