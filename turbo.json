{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "PORT", "HOST", 
    "DATABASE_URL", 
    "NODE_ENV",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "JWT_ISS",
    "JWT_ACCESS_AUD",
    "JWT_REFRESH_AUD"
  ],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}